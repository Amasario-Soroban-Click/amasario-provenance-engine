#!/usr/bin/env bash
#
# Render one captured analysis in every format the engine produces.
#
# Runs offline: a snapshot is a document, so reading it back and re-rendering it needs no
# network. The snapshot is generated by the corpus from the engine's own types, so this
# exercises the real renderers rather than a fixture written for them.
set -euo pipefail

snapshot="${AMASARIO_SNAPSHOT:-fixtures/snapshots/testnet-alpha-after.json}"
amasario=(cargo run -q -p amasario-cli --)

echo "== snapshot show =="
"${amasario[@]}" snapshot show --input "${snapshot}"

for format in json yaml dot graphml; do
  echo
  echo "== export --format ${format} =="
  "${amasario[@]}" export --input "${snapshot}" --format "${format}"
done
