# Build output.
/target/

# The normative specification, checked out into the workspace root. CI clones
# `amasario-provenance-spec` to this path so that the conformance tests in
# `amasario-core` have something to compare the engine's vocabularies against, and
# the tests read the same path locally through `AMASARIO_SPEC_DIR`. It is a second
# repository rather than part of this one, so it must never be committed here.
#
# No trailing slash, deliberately: that form matches directories only, and Git
# treats a symlink as a file. CI produces a directory and a local setup may well
# symlink one, so the rule has to match both.
/.amasario-spec

# Cargo.lock is committed deliberately: the engine is an application as well as a
# library set, so a build must not resolve a different version graph than the one
# that was reviewed and audited.

# Editor and OS noise.
*.swp
*.swo
.DS_Store
.idea/
.vscode/*.log

# Analysis output. The engine writes reports and snapshots where the caller asks;
# a stray one in the working tree must not be committed by accident.
/out/
/artifacts/
*.snapshot.json

# Coverage and profiling output.
/coverage/
*.profraw
*.profdata
/criterion/

# Fuzzing corpus. The interesting cases belong in `fuzz/<target>/corpus`, which is
# committed; libFuzzer's own accumulated corpus is not, because it is machine-state
# rather than a reviewable artefact.
fuzz/artifacts/
fuzz/coverage/
fuzz/target/
